#version 460
#extension GL_EXT_ray_query : enable

#define PT_CONFIG_RAYQUERY
#define PT_DEV_FEATURES
#include "Common.glsl"

// Dev variant of PathTracer.comp: compiles in the features the default kernel bakes out.

layout(local_size_x = PT_RAYQUERY_TILE_X, local_size_y = PT_RAYQUERY_TILE_Y) in;

void main()
{
	ivec2 pixelIndex = ivec2(gl_GlobalInvocationID.xy);
	if (pixelIndex.x >= outputSize.x || pixelIndex.y >= outputSize.y)
	{
		return;
	}

	PathTracerContext ctx;
	ptRenderPixel(ctx, pixelIndex);
}
